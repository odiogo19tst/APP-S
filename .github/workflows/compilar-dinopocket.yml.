      - name: Executar testes automatizados
        working-directory: dinopocket
        run: npm test

      - name: Instalar compilador Zepp OS Zeus
        run: npm install --global @zeppos/zeus-cli

      - name: Gerar pacote ZAB
        working-directory: dinopocket
        run: zeus build

      - name: Verificar ZAB
        shell: bash
        run: |
          find dinopocket/dist -type f -name '*.zab' -print
          test "$(find dinopocket/dist -type f -name '*.zab' | wc -l)" -gt 0

      - name: Disponibilizar jogo para baixar
        uses: actions/upload-artifact@v4
        with:
          name: DinoPocket-Bip6-ZAB
          path: dinopocket/dist/**/*.zab
          if-no-files-found: error
          retention-days: 30
